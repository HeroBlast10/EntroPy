# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/

# Data outputs (large Parquet files — tracked via manifest, not git)
data/*.parquet
data/**/*.parquet
data/**/*.csv
data/**/*.json
data/**/*.html
data/manifest.json
data/backtest/
data/portfolio/
data/factors/
data/reports/
data/live/
data/experiments/
data/fundamentals/
data/research/

# Keep the data directory structure
!data/.gitkeep

# SimFin cache
simfin_data/

# Numba JIT cache
*.nbi
*.nbc

# Pytest
.pytest_cache/
.pytest_tmp/
.pytest_*/
.pytest_*.xml
.pytest_*.log
.universe_build.*.log
htmlcov/
.coverage

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Env
.env
*.env
venv/
.venv/

# Internal notes / interview prep docs (never push to the public repo).
# All such files live under local_docs/, including the 11 implementation /
# prep markdown files moved there from the repo root on 2026-10-15.
local_docs/

# Local agent / IDE workspace state (private working notes, never public)
.workbuddy/

# Snapshot taken before a full artifact rebuild (local comparison copies only)
data/_backup_*/

# ---------------------------------------------------------------------------
# WRDS data is subscription-licensed: committing it would breach the licence
# and would also be unreproducible for anyone without the same entitlement.
# All WRDS products are pulled into data/wrds/ by scripts/wrds_pull.py and are
# rebuilt from source, not stored.
data/wrds/

# WRDS credentials. scripts/wrds_setup_auth.py writes to PostgreSQL's pgpass;
# the JSON alternatives below are supported for convenience only.
config/wrds_credentials.json
.wrds_credentials.json
pgpass.conf
